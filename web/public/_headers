# Response headers on Cloudflare Pages (same as security-headers.conf and the caching in nginx.conf).
# The Docker/nginx setup ignores this file.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Built JS and CSS have a content hash in their names, so they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
