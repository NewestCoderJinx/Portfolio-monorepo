# Copy to api/.env for local development (and/or repo-root .env for docker compose)

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=secret_password
POSTGRES_DB=portfolio_db

# Backend API
PORT=3000
JWT_SECRET=change_me_to_a_long_random_string
# Only the first account can register. Set to true temporarily to add another admin.
ALLOW_REGISTRATION=false

# Frontend (web/.env)
VITE_API_URL=http://localhost:3000

# Link previews & search engines (baked into index.html at build time;
# LinkedIn/WhatsApp/Slack/X don't run JavaScript, so these must be set before building)
VITE_SITE_TITLE="Your Name | Your Headline"
VITE_SITE_DESCRIPTION="One or two sentences about what you build."
# Public URL of the deployed site, e.g. https://yourname.dev (enables og:url + canonical)
VITE_SITE_URL=
# Preview image, ideally 1200x630: absolute URL or a path under web/public (e.g. og-image.png)
VITE_OG_IMAGE=
